# Port the app listens on (UI + audio served to Sonos from the same port)
PORT=3500

# Optional: force the LAN IP used in loop URLs handed to Sonos.
# Only needed if auto-detection picks the wrong interface (VPN, Docker, etc).
# Find yours on macOS with: ipconfig getifaddr en0
# HOST_IP=192.168.1.50

# Optional: skip multicast discovery and bootstrap from one known speaker IP.
# The whole Sonos household is learned from this device's topology.
# Use this if speakers aren't discovered (blocked SSDP, VPN, macOS Local
# Network permission). Find an IP in the Sonos app: Settings > About My System.
# SONOS_HOST=192.168.1.60
